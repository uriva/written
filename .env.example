# InstantDB (required)
NEXT_PUBLIC_INSTANT_APP_ID=fe53f2bb-9774-47db-9ed6-8c7c2dab43a5
NEXT_PUBLIC_INSTANT_API_URI=https://api.instantdb.uriv.me
NEXT_PUBLIC_INSTANT_WS_URI=wss://api.instantdb.uriv.me/runtime/session

# Server-only admin token. Never commit this value.
# If it was ever committed or shared, rotate it in the InstantDB dashboard.
INSTANT_APP_ADMIN_TOKEN=

# Canonical public URL used in webhook payloads, feeds and llms.txt.
NEXT_PUBLIC_SITE_URL=https://written.example.com

# Shared secret for POST /api/cron/webhooks (retry sweep).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Local development only: allow http:// and private webhook targets.
# WEBHOOK_ALLOW_PRIVATE=true
